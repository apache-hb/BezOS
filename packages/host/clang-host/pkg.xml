<package name="clang-host" version="21.x">
    <private-dependency name="llvm-source" version="21.x" />
    <private-dependency name="cmake-host" version="4.x" />
    <private-dependency name="gcc-host" version="15.x" />
    <private-dependency name="libstdcxx-host" version="15.x" />

    <configure with="cmake" executable="${package.sysroot}/bin/cmake" src="${package.sysroot}/src/llvm-project/llvm">
        <option name="LLVM_ENABLE_PROJECTS" value="llvm;clang;clang-tools-extra;lld" />
        <option name="LLVM_ENABLE_RUNTIMES" value="compiler-rt" />
        <option name="CMAKE_C_COMPILER" value="clang" />
        <option name="CMAKE_CXX_COMPILER" value="clang++" />
        <option name="CMAKE_LINKER" value="ld.lld" />
        <env LD_LIBRARY_PATH="${package.sysroot}/lib:${package.sysroot}/lib64" />
    </configure>
</package>
